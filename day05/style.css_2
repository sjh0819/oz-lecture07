* {
  box-sizing: ;border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: beige;
  color:black;
  font-family: sans-serif;
  line-height: 1.6;
  padding: 24px;
  /* width:800px;
  margin:auto; */
}

h1 {
  color: #0b6fb8;
}

.nav {
  dispaly: flex;
  justify-content:space-between;
  align-items:center;
  padding:19px 20px;
  background-color: #fff;
  border:1px solid #d4dee6;
  margin0bottom:32px;  
}

.logo {
  font-weght: bold;
  color:#0b6fb8;
  }

  .menu {
    display:flex;
    gap:16px;
    list-style:none;    
  }

  .menu a{
    text-decoration:none;
    color:#074068;    
  }

  .menu a:hover{
    color:#0b6fb8;
  }

  .cards{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap: 20px;
    margin-top:16px;
  }

  .card{
    padding:20px;
    border:1px solid #d3dee6;
    border-radius:8px;
    background-color:#fff;    
  }

  .card h3{
    margin-bottom:8px;
  }

section {
  margin:0 0 40px 0;
}

form label {
  display:block;
  margin: tpo 12px;
  font-weght:bold;
}
form input,
form textarea {
  display:block;
  width:100%;
  padding:8px;
  border:1px solid beige;
  border-radius:4px;
}

form button {
  display:inline0block;
  margin:16px 0px;
  padding:10px 20px;
  border:none;
  border: radius 4px;
  background: color #0b6fb8;
  color: #fff;
  cursor:pointer;
}

fieldset {
  border:1px solid #d3dee6;
  border-radius:8px;
  padding:16px 20px 20px;
}

leggend {
  padding:0 8px;
  color: #0b6fb8;

}

.lead {
  font: size 18px;
  color: darkgrey;
}

#contact {
  border-top: :2px solid #0b6fb8;
  padding-top:24px;
}
